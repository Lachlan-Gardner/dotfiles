
/*****----- Configuration -----*****/
configuration {
	modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-filebrowser:        "";
    display-window:             "";
	drun-display-format:        "{name}";
	window-format:              "{w} · {c} · {t}";
}

/*****----- Global Properties -----*****/
@import                          "~/.cache/wal/colors-rofi-dark.rasi"

/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    north;
    anchor:                      center;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    margin:                      0px;
    padding:                     0px;
    cursor:                      "default";
    border-radius: 5px;
    /* Backgroud Colors */
    background-color: transparent;
    
}

/*****----- Main Box -----*****/
mainbox {
  border-radius: 5px;
    enabled:                     true;
    //spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    children:                    [ "inputbar", "listview"];
    background-color: rgba(0, 0, 0, 0);
    border-color: transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     5px;
    margin:                      0px;
    padding:                     3px 3px 3px 5px;
    border:                      1px solid;
    border-radius:               5px;
    border-color:                @border-color;
    text-color:                  @foreground;
    background-color: rgba(0, 0, 0, 0.6);
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "::";
    background-color:            transparent;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;
    
    spacing:                     5px;
    margin:                      0px;
    padding:                     5px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     8px;
    margin:                      0px;
    padding:                     5px;
    border:                      1px solid;
    border-radius:               10px;
    border-color:                @border-color;
    background-color:            rgba(0, 0, 0, 0.6);
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            rgba(0, 0, 0, 0.6);
    text-color:                  var(normal-foreground);
}
element selected.normal {
    background-color:            @active-foreground;
    text-color:                  rgba(0, 0, 0, 0.6);
}
element alternate.normal {
    background-color:            rgba(0, 0, 0, 0.6);
    text-color:                  var(alternate-normal-foreground);
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
