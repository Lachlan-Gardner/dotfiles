{
    "custom/notify": {
        "format": "{icon} ",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // waybar cava
    "custom/cava": {
        "exec": "/home/Lachlan/.config/waybar/scripts/cava.sh",
        "framerate": 60
    },

    // Leaf: 
    // Lightning: 
    // Scales: 
    "custom/power-saver": {
        "format":"",
        "on-click": "tlpctl set power-saver"        
    },

    "custom/balanced": {
        "format":"",
        "on-click": "tlpctl set balanced"        
    },

    "custom/performance": {
        "format":"",
        "on-click": "tlpctl set performance"        
    },

    "custom/current-mode": {
        "format": "{icon}",
        "format-icons": {
            "power-saver": "",
            "performance": "",
            "balanced": ""
        },
        "exec": "/home/Lachlan/dotfiles/waybar/.config/waybar/scripts/currentPowerSavingMode",
        "return-type": "json",
        "interval": 0.3
    }
}
